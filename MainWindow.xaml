<Window x:Class="wSpot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:wSpot.Helpers"
        Title="wSpot"
        Width="900"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated"
        Visibility="Visible"
        ResizeMode="NoResize">

    <Window.InputBindings>
        <!-- Enter opens the highlighted row. Ctrl+Enter opens the folder that holds it. -->
        <KeyBinding Key="Return" Command="{Binding LaunchCommand}" />
        <KeyBinding Key="Return" Modifiers="Control" Command="{Binding RevealCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- One row of the results list: white text, a rounded highlight on hover
             and on the selected row, and content stretched to the full row width
             so the badge can sit on the right-hand edge. A click anywhere on the
             row opens it (handled in the code-behind). -->
        <Style x:Key="ResultRowStyle" TargetType="ListBoxItem">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ResultRow_PreviewMouseLeftButtonDown" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                Margin="6,1"
                                CornerRadius="6"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#FF2D2D30" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#FF094771" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="30"
            Background="#FF252526"
            BorderBrush="#FF3E3E42"
            BorderThickness="1">
        <StackPanel>
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent"
                     Foreground="White"
                     BorderThickness="0"
                     FontSize="20"
                     Height="60"
                     VerticalContentAlignment="Center"
                     Padding="16,0,16,0"
                     CaretBrush="White"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" />

            <!-- Small heading above the list ("Frequently used"). Hidden while ListHeader is empty. -->
            <TextBlock Text="{Binding ListHeader}"
                       Foreground="#FF9D9D9D"
                       FontSize="11"
                       Padding="16,2,16,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ListHeader}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ListBox x:Name="ResultsListBox"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult}"
                     ItemContainerStyle="{StaticResource ResultRowStyle}"
                     SelectionChanged="ResultsListBox_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     MaxHeight="420">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,6" ToolTip="{Binding ToolTipText}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon: the Windows icon once it has loaded; until then (and for
                                 rows with no file to take an icon from) a symbol for the kind. -->
                            <Grid Grid.Column="0"
                                  Width="30"
                                  Height="30"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center">
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="#FF9D9D9D"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Image Source="{Binding Icon}"
                                       Width="28"
                                       Height="28"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <!-- The letters you typed are drawn in bold and in colour. -->
                                <TextBlock FontSize="15"
                                           TextTrimming="CharacterEllipsis"
                                           helpers:HighlightText.Text="{Binding Name}"
                                           helpers:HighlightText.Indices="{Binding MatchedIndices}" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="11"
                                           Foreground="#FF9D9D9D"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Margin="12,0,0,0"
                                    Padding="6,1"
                                    CornerRadius="4"
                                    Background="#FF3A3A3F"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindLabel}"
                                           FontSize="10"
                                           Foreground="#FFB4B4B4" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer note: hidden while StatusMessage is empty. -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#FF9D9D9D"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Padding="16,4,16,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
